{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "leadflix",
	"main": "crm-worker.js",
	"compatibility_date": "2026-07-01",
	"assets": {
		"directory": "./crm",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{ "pattern": "leads.loxeai.com", "custom_domain": true }
	]
}
